# Copy to .env and fill in. .env is gitignored; this file is committed.

# Google AI Studio — https://aistudio.google.com/apikey
# Volume workhorse. Free tier is metered in requests per day, so the cache
# and request accounting in the runner are what make iteration possible.
GEMINI_API_KEY=

# Hugging Face Inference Providers — https://huggingface.co/settings/tokens
# Must be a FINE-GRAINED token with "Make calls to Inference Providers".
# A Read token authenticates against the Hub and is rejected by the router,
# which surfaces as a confusing 401.
# Used as the second model family for the agreement measurement, not for
# volume: the free credit allowance is very small.
HF_TOKEN=
